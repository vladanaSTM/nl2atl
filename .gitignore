# Exclude folders
models
scripts
genVITAMIN
chroma_db
logs

# Ignore everything under outputs, then re-include the paper sources below.
# NOTE: Git will not descend into an ignored directory, so each parent
# directory must be re-included (!dir/) and its contents re-ignored (dir/*)
# before a nested file can be un-ignored.
outputs/*

# Descend into outputs/paper/AAAI.../
!outputs/paper/
outputs/paper/*
!outputs/paper/AAAI_Translating_Natural_Language_to_Strategic_Temporal_Specifications_via_LLMs/
outputs/paper/AAAI_Translating_Natural_Language_to_Strategic_Temporal_Specifications_via_LLMs/*

# Keep these whole folders
!outputs/paper/AAAI_Translating_Natural_Language_to_Strategic_Temporal_Specifications_via_LLMs/images/
!outputs/paper/AAAI_Translating_Natural_Language_to_Strategic_Temporal_Specifications_via_LLMs/sections/

# Keep this file
!outputs/paper/AAAI_Translating_Natural_Language_to_Strategic_Temporal_Specifications_via_LLMs/bibliography.bib

# Descend into AnonymousSubmission/LaTeX/ for the specific source files
!outputs/paper/AAAI_Translating_Natural_Language_to_Strategic_Temporal_Specifications_via_LLMs/AnonymousSubmission/
outputs/paper/AAAI_Translating_Natural_Language_to_Strategic_Temporal_Specifications_via_LLMs/AnonymousSubmission/*
!outputs/paper/AAAI_Translating_Natural_Language_to_Strategic_Temporal_Specifications_via_LLMs/AnonymousSubmission/LaTeX/
outputs/paper/AAAI_Translating_Natural_Language_to_Strategic_Temporal_Specifications_via_LLMs/AnonymousSubmission/LaTeX/*
!outputs/paper/AAAI_Translating_Natural_Language_to_Strategic_Temporal_Specifications_via_LLMs/AnonymousSubmission/LaTeX/anonymous_main.tex
!outputs/paper/AAAI_Translating_Natural_Language_to_Strategic_Temporal_Specifications_via_LLMs/AnonymousSubmission/LaTeX/appendix.tex
!outputs/paper/AAAI_Translating_Natural_Language_to_Strategic_Temporal_Specifications_via_LLMs/AnonymousSubmission/LaTeX/build.ps1

